{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Browser shell UI only. Tab webviews load remote content and get no capabilities.",
  "webviews": [
    "main"
  ],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "allow-shell-ready",
    "allow-set-layout",
    "allow-overlay-open",
    "allow-overlay-close",
    "allow-run-command",
    "allow-tab-new",
    "allow-tab-close",
    "allow-tab-close-others",
    "allow-tab-activate",
    "allow-tab-reopen",
    "allow-tab-pin",
    "allow-tab-move",
    "allow-tab-mute",
    "allow-tab-sleep",
    "allow-tab-duplicate",
    "allow-navigate",
    "allow-nav",
    "allow-zoom",
    "allow-find-query",
    "allow-find-step",
    "allow-find-close",
    "allow-suggest",
    "allow-ntp-data",
    "allow-history-query",
    "allow-history-delete",
    "allow-bookmarks-all",
    "allow-bookmark-create",
    "allow-bookmark-update",
    "allow-bookmark-move",
    "allow-bookmark-delete",
    "allow-bookmark-toggle",
    "allow-downloads-list",
    "allow-download-command",
    "allow-downloads-clear",
    "allow-settings-get",
    "allow-settings-set",
    "allow-gaming-set",
    "allow-permission-respond",
    "allow-site-permissions",
    "allow-site-permission-set",
    "allow-clear-data",
    "allow-perf-subscribe",
    "allow-profiles-list",
    "allow-profile-create",
    "allow-profile-rename",
    "allow-profile-switch",
    "allow-first-run-complete",
    "allow-import-detect",
    "allow-import-run",
    "allow-ai-config-get",
    "allow-ai-config-set",
    "allow-ai-chat",
    "allow-ai-cancel",
    "allow-app-info",
    "allow-update-check",
    "allow-update-install"
  ]
}
